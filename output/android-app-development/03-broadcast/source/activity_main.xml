<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/app_title"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/app_subtitle"
        android:textColor="@color/text_sub"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_unordered"
            style="@style/DuckButton"
            android:background="@drawable/btn_primary"
            android:text="@string/send_unordered" />

        <Button
            android:id="@+id/btn_ordered"
            style="@style/DuckButton"
            android:background="@drawable/btn_primary"
            android:text="@string/send_ordered" />

        <Button
            android:id="@+id/btn_same_priority"
            style="@style/DuckButton"
            android:background="@drawable/btn_secondary"
            android:text="@string/send_same_priority" />

        <Button
            android:id="@+id/btn_intercept"
            style="@style/DuckButton"
            android:background="@drawable/btn_warning"
            android:text="@string/send_intercept" />

        <Button
            android:id="@+id/btn_static"
            style="@style/DuckButton"
            android:background="@drawable/btn_secondary"
            android:text="@string/send_static" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/result_title"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/result_bg"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="@string/result_empty"
            android:textColor="@color/text_main"
            android:textSize="15sp" />
    </ScrollView>

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/btn_clear"
        android:text="@string/clear_result"
        android:textColor="@color/text_main"
        android:textSize="15sp" />

</LinearLayout>
