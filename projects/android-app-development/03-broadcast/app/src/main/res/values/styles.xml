<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Broadcast" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/duck_blue</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="DuckButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
