<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/register_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:text="@string/register_title"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:orientation="horizontal">

            <TextView
                style="@style/tvOne"
                android:drawableTop="@drawable/qq_icon"
                android:text="@string/register_qq" />

            <View style="@style/vLine" />

            <TextView
                style="@style/tvOne"
                android:drawableTop="@drawable/weixin_icon"
                android:text="@string/register_wechat" />
        </LinearLayout>

        <View style="@style/hLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:contentDescription="@string/register_email"
                android:src="@drawable/email_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/register_email"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <View style="@style/hLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/tvTwo"
                android:text="@string/label_name" />

            <EditText
                android:id="@+id/et_name"
                style="@style/etOne"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/hint_name"
                android:singleLine="true"
                android:textColorHint="@color/register_hint" />
        </LinearLayout>

        <View style="@style/hLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/tvTwo"
                android:text="@string/label_email" />

            <EditText
                android:id="@+id/et_email"
                style="@style/etOne"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColorHint="@color/register_hint" />
        </LinearLayout>

        <View style="@style/hLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/tvTwo"
                android:text="@string/label_pwd" />

            <EditText
                android:id="@+id/et_pwd"
                style="@style/etOne"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/hint_pwd"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColorHint="@color/register_hint" />
        </LinearLayout>

        <View style="@style/hLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/tvTwo"
                android:text="@string/label_sex" />

            <RadioGroup
                android:id="@+id/rg_sex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_boy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@android:color/white"
                    android:text="@string/sex_boy"
                    android:textColor="@android:color/white" />

                <RadioButton
                    android:id="@+id/rb_girl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:buttonTint="@android:color/white"
                    android:text="@string/sex_girl"
                    android:textColor="@android:color/white" />
            </RadioGroup>
        </LinearLayout>

        <View style="@style/hLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                style="@style/tvTwo"
                android:text="@string/label_hobby" />

            <CheckBox
                android:id="@+id/cb_sing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:buttonTint="@android:color/white"
                android:text="@string/hobby_sing"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/cb_dance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:buttonTint="@android:color/white"
                android:text="@string/hobby_dance"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/cb_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:buttonTint="@android:color/white"
                android:text="@string/hobby_read"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <View style="@style/hLine" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="160dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="52dp"
            android:background="@drawable/submit_btn_bg"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textColor="@color/register_button_text"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
